<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.ManagerStockController"
      styleClass="page" spacing="14">

    <!-- Header -->
    <Label text="Stock Overview" styleClass="page-title"/>

    <!-- Stock table -->
    <TableView fx:id="tableStock" styleClass="table-view" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"       text="ID"       prefWidth="70"/>
            <TableColumn fx:id="colName"     text="Name"     prefWidth="200"/>
            <TableColumn fx:id="colPrice"    text="Price"    prefWidth="120"/>
            <TableColumn fx:id="colStock"    text="Stock"    prefWidth="90"/>
            <TableColumn fx:id="colCategory" text="Category" prefWidth="150"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Back -->
    <Button text="← Back" onAction="#onBack" styleClass="btn-ghost"/>

</VBox>
