<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controller.CustomerDashboardController"
           styleClass="page">

    <VBox alignment="CENTER" spacing="0" maxWidth="360">

        <Label fx:id="lblWelcome" text="Welcome!" styleClass="page-title"
               style="-fx-font-size: 24px;"/>
        <Label text="What would you like to do?" styleClass="subtitle"
               style="-fx-padding: 4 0 28 0;"/>

        <VBox spacing="10" alignment="CENTER">
            <Button text="Browse Products"     onAction="#onViewMenu"    styleClass="btn-nav"/>
            <Button text="View Cart"           onAction="#onViewCart"    styleClass="btn-nav"/>
            <Button text="My Orders"           onAction="#onViewOrders"  styleClass="btn-nav"/>
            <Button text="Cancel Pending Order" onAction="#onCancelOrder" styleClass="btn-nav"/>
        </VBox>

        <Region styleClass="spacer-lg"/>

        <Button text="Logout" onAction="#onLogout"
                styleClass="btn-danger" prefWidth="120"/>

    </VBox>
</StackPane>
