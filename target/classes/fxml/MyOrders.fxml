<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.MyOrdersController"
      styleClass="page" spacing="14">

    <!-- Header -->
    <Label text="My Orders" styleClass="page-title"/>

    <!-- Filter toolbar -->
    <HBox styleClass="toolbar">
        <Button text="All"        onAction="#onAll"        styleClass="btn-secondary" prefHeight="32"/>
        <Button text="Pending"    onAction="#onPending"    styleClass="btn-secondary" prefHeight="32"/>
        <Button text="Processing" onAction="#onProcessing" styleClass="btn-secondary" prefHeight="32"/>
        <Button text="Delivered"  onAction="#onDelivered"  styleClass="btn-secondary" prefHeight="32"/>
        <Button text="Cancelled"  onAction="#onCancelled"  styleClass="btn-secondary" prefHeight="32"/>
    </HBox>

    <!-- Orders table -->
    <TableView fx:id="tableOrders" styleClass="table-view" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colOrderId" text="Order ID" prefWidth="90"/>
            <TableColumn fx:id="colProduct" text="Product"  prefWidth="180"/>
            <TableColumn fx:id="colQty"     text="Qty"      prefWidth="70"/>
            <TableColumn fx:id="colPayment" text="Payment"  prefWidth="130"/>
            <TableColumn fx:id="colTotal"   text="Total"    prefWidth="110"/>
            <TableColumn fx:id="colStatus"  text="Status"   prefWidth="110"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Back -->
    <Button text="← Back" onAction="#onBack" styleClass="btn-ghost"/>

</VBox>
