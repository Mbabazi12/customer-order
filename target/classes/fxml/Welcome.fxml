<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controller.WelcomeController"
           styleClass="page">

    <VBox alignment="CENTER" spacing="0" maxWidth="340">

        <!-- Title -->
        <Label text="Customer Order System" styleClass="page-title"
               style="-fx-font-size: 26px; -fx-padding: 0 0 4 0;"/>
        <Label text="Select your role to continue" styleClass="subtitle"
               style="-fx-padding: 0 0 36 0;"/>

        <!-- Nav buttons -->
        <VBox spacing="12" alignment="CENTER">
            <Button text="Customer" onAction="#onCustomer"
                    styleClass="btn-nav" prefWidth="260"/>
            <Button text="Manager"  onAction="#onManager"
                    styleClass="btn-nav" prefWidth="260"/>
        </VBox>

        <Region styleClass="spacer-lg"/>

        <Button text="Exit" onAction="#onExit"
                styleClass="btn-danger"
                prefWidth="120" style="-fx-font-size: 12px;"/>

    </VBox>
</StackPane>
