<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controller.CustomerAuthController"
           styleClass="page">

    <VBox alignment="CENTER" spacing="0" maxWidth="420">

        <Label text="Customer Login" styleClass="page-title"
               style="-fx-font-size: 24px;"/>
        <Label text="Enter your phone number to continue."
               styleClass="subtitle" style="-fx-padding: 4 0 28 0;"/>

        <!-- Step 1: Phone lookup -->
        <VBox spacing="10">
            <TextField fx:id="tfPhone" promptText="Phone number (e.g. 0712345678)"
                       styleClass="text-field" maxWidth="360"/>
            <Label fx:id="lblPhoneError" text="" styleClass="lbl-error"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="Continue" onAction="#onContinue"
                        styleClass="btn-primary" prefWidth="140" prefHeight="38"/>
            </HBox>
        </VBox>

        <!-- Step 2: Registration panel (hidden until phone not found) -->
        <VBox fx:id="regPanel" spacing="10" style="-fx-padding: 24 0 0 0;">
            <Label text="Phone not found. Create your account below."
                   styleClass="subtitle" style="-fx-text-fill: #4a90d9;"/>
            <TextField fx:id="tfName"     promptText="Full Name"    styleClass="text-field" maxWidth="360"/>
            <TextField fx:id="tfEmail"    promptText="Email"        styleClass="text-field" maxWidth="360"/>
            <TextField fx:id="tfRegPhone" promptText="Phone"        styleClass="text-field" maxWidth="360"
                       editable="false" style="-fx-opacity: 0.7;"/>
            <TextField fx:id="tfAddress"  promptText="Address"      styleClass="text-field" maxWidth="360"/>
            <Label fx:id="lblRegError" text="" styleClass="lbl-error"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="Register" onAction="#onRegister"
                        styleClass="btn-success" prefWidth="140" prefHeight="38"/>
                <Button text="Cancel"   onAction="#onCancelReg"
                        styleClass="btn-secondary" prefWidth="110" prefHeight="38"/>
            </HBox>
        </VBox>

        <Region styleClass="spacer-md"/>
        <Button text="← Back" onAction="#onBack" styleClass="btn-ghost"/>

    </VBox>
</StackPane>
