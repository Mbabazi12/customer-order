<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controller.ManagerDashboardController"
           styleClass="page">

    <VBox alignment="CENTER" spacing="0" maxWidth="360">

        <Label text="Manager Dashboard" styleClass="page-title"
               style="-fx-font-size: 24px;"/>
        <Label text="Select an action below" styleClass="subtitle"
               style="-fx-padding: 4 0 28 0;"/>

        <VBox spacing="10" alignment="CENTER">
            <Button text="View All Customers"  onAction="#onViewCustomers"  styleClass="btn-nav"/>
            <Button text="Manage Orders"       onAction="#onViewOrders"     styleClass="btn-nav"/>
            <Button text="View Stock"          onAction="#onViewStock"      styleClass="btn-nav"/>
        </VBox>

        <Region styleClass="spacer-lg"/>

        <Button text="Logout" onAction="#onLogout"
                styleClass="btn-danger" prefWidth="120"/>

    </VBox>
</StackPane>
