<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.ManagerOrdersController"
      styleClass="page" spacing="14">

    <!-- Header -->
    <Label text="All Orders" styleClass="page-title"/>

    <!-- Orders table -->
    <TableView fx:id="tableOrders" styleClass="table-view" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colOrderId"  text="Order ID"  prefWidth="90"/>
            <TableColumn fx:id="colCustomer" text="Customer"  prefWidth="150"/>
            <TableColumn fx:id="colProduct"  text="Product"   prefWidth="160"/>
            <TableColumn fx:id="colQty"      text="Qty"       prefWidth="65"/>
            <TableColumn fx:id="colPayment"  text="Payment"   prefWidth="130"/>
            <TableColumn fx:id="colTotal"    text="Total"     prefWidth="100"/>
            <TableColumn fx:id="colStatus"   text="Status"    prefWidth="110"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Status update row -->
    <HBox styleClass="toolbar">
        <Label text="New Status:" styleClass="lbl-form" style="-fx-min-width: 90;"/>
        <ComboBox fx:id="cbStatus" styleClass="combo-box" prefWidth="160" prefHeight="36"/>
        <Button text="Update Status" onAction="#onUpdateStatus"
                styleClass="btn-primary" prefHeight="36"/>
        <Button text="Cancel Order"  onAction="#onCancelOrder"
                styleClass="btn-danger"  prefHeight="36"/>
        <Label fx:id="lblMsg" text="" styleClass="lbl-success"
               style="-fx-padding: 0 0 0 14;"/>
    </HBox>

    <!-- Add order manually section -->
    <Label text="Add Order Manually" styleClass="subtitle"
           style="-fx-font-size: 13px; -fx-text-fill: #9090a8; -fx-padding: 8 0 4 0;"/>

    <HBox styleClass="toolbar">
        <TextField fx:id="tfCustomerId" promptText="Customer ID" styleClass="text-field"
                   prefWidth="120" prefHeight="34"/>
        <TextField fx:id="tfProductId"  promptText="Product ID"  styleClass="text-field"
                   prefWidth="110" prefHeight="34"/>
        <TextField fx:id="tfQty"        promptText="Qty"         styleClass="text-field"
                   prefWidth="70"  prefHeight="34"/>
        <TextField fx:id="tfPayment"    promptText="Payment (e.g. Cash)" styleClass="text-field"
                   prefWidth="160" prefHeight="34"/>
        <Button text="Add Order" onAction="#onAddOrder"
                styleClass="btn-success" prefHeight="34"/>
    </HBox>
    <Label fx:id="lblAddMsg" text="" styleClass="lbl-success" wrapText="true"/>

    <!-- Back -->
    <Button text="← Back" onAction="#onBack" styleClass="btn-ghost"/>

</VBox>
