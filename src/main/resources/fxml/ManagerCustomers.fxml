<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.ManagerCustomersController"
      styleClass="page" spacing="14">

    <!-- Header -->
    <Label text="All Customers" styleClass="page-title"/>

    <!-- Search toolbar -->
    <HBox styleClass="toolbar">
        <TextField fx:id="tfSearch" promptText="Search by name or email…"
                   styleClass="text-field" prefWidth="300" prefHeight="34"/>
        <Button text="Search" onAction="#onSearch" styleClass="btn-primary"   prefHeight="34"/>
        <Button text="Reset"  onAction="#onReset"  styleClass="btn-secondary" prefHeight="34"/>
    </HBox>

    <!-- Customers table -->
    <TableView fx:id="tableCustomers" styleClass="table-view" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"      text="ID"      prefWidth="65"/>
            <TableColumn fx:id="colName"    text="Name"    prefWidth="170"/>
            <TableColumn fx:id="colEmail"   text="Email"   prefWidth="210"/>
            <TableColumn fx:id="colPhone"   text="Phone"   prefWidth="130"/>
            <TableColumn fx:id="colAddress" text="Address" prefWidth="200"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Back -->
    <Button text="← Back" onAction="#onBack" styleClass="btn-ghost"/>

</VBox>
