<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controller.ManagerAuthController"
           styleClass="page">

    <VBox alignment="CENTER" spacing="0" maxWidth="340">

        <Label text="Manager Login" styleClass="page-title"
               style="-fx-font-size: 24px;"/>
        <Label text="Enter the manager password to continue."
               styleClass="subtitle" style="-fx-padding: 4 0 28 0;"/>

        <PasswordField fx:id="pfPassword" promptText="Password"
                       styleClass="password-field" maxWidth="300"/>

        <Label fx:id="lblError" text="" styleClass="lbl-error"
               style="-fx-padding: 8 0 4 0;"/>

        <HBox spacing="12" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
            <Button text="Login"  onAction="#onLogin" styleClass="btn-primary"   prefWidth="130" prefHeight="38"/>
            <Button text="← Back" onAction="#onBack"  styleClass="btn-secondary" prefWidth="110" prefHeight="38"/>
        </HBox>

    </VBox>
</StackPane>
