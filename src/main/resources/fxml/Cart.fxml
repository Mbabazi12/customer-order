<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.CartController"
      styleClass="page" spacing="14">

    <!-- Header -->
    <Label text="Your Cart" styleClass="page-title"/>
    <Label text="Review your items, adjust quantities, then place your order."
           styleClass="subtitle"/>

    <!-- Cart table -->
    <TableView fx:id="tableCart" styleClass="table-view" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName"     text="Product"    prefWidth="220"/>
            <TableColumn fx:id="colPrice"    text="Unit Price" prefWidth="130"/>
            <TableColumn fx:id="colQty"      text="Qty"        prefWidth="80"/>
            <TableColumn fx:id="colLineTotal" text="Line Total" prefWidth="130"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Quantity controls row -->
    <HBox styleClass="toolbar">
        <Button text="+ Increase" onAction="#onIncrease" styleClass="btn-secondary" prefHeight="34"/>
        <Button text="- Decrease" onAction="#onDecrease" styleClass="btn-secondary" prefHeight="34"/>
        <Button text="Remove Item" onAction="#onRemoveItem" styleClass="btn-danger"  prefHeight="34"/>
    </HBox>

    <!-- Total + payment + checkout -->
    <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 8 0 0 0;">
        <Label fx:id="lblTotal" text="Grand Total:  0.00"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #e0e0e0;"/>
        <Label text="Payment:" styleClass="lbl-form" style="-fx-min-width: 70;"/>
        <ComboBox fx:id="cbPayment" styleClass="combo-box" prefWidth="180" prefHeight="36"/>
        <Button text="Place Order" onAction="#onCheckout"
                styleClass="btn-success" prefHeight="38" prefWidth="140"/>
    </HBox>

    <!-- Feedback -->
    <Label fx:id="lblMsg" text="" styleClass="lbl-error" wrapText="true"/>

    <!-- Navigation -->
    <HBox spacing="12">
        <Button text="Continue Shopping" onAction="#onContinueShopping"
                styleClass="btn-secondary" prefHeight="34"/>
        <Button text="← Back" onAction="#onBack" styleClass="btn-ghost"/>
    </HBox>

</VBox>
