<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.CancelOrderController"
      styleClass="page" spacing="14">

    <!-- Header -->
    <Label text="Cancel Pending Order" styleClass="page-title"/>
    <Label text="Select a pending order below and click Cancel Order."
           styleClass="subtitle"/>

    <!-- Pending orders table -->
    <TableView fx:id="tablePending" styleClass="table-view" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colOrderId" text="Order ID" prefWidth="90"/>
            <TableColumn fx:id="colProduct" text="Product"  prefWidth="200"/>
            <TableColumn fx:id="colQty"     text="Qty"      prefWidth="70"/>
            <TableColumn fx:id="colTotal"   text="Total"    prefWidth="110"/>
            <TableColumn fx:id="colStatus"  text="Status"   prefWidth="110"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Action row -->
    <HBox styleClass="toolbar">
        <Button text="Cancel Selected Order" onAction="#onCancelSelected"
                styleClass="btn-danger" prefHeight="38"/>
        <Label fx:id="lblMsg" text="" styleClass="lbl-success"
               style="-fx-padding: 0 0 0 14;"/>
    </HBox>

    <!-- Back -->
    <Button text="← Back" onAction="#onBack" styleClass="btn-ghost"/>

</VBox>
