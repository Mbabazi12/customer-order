<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.ProductController"
      styleClass="page" spacing="14">

    <!-- Header row -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="Browse Products" styleClass="page-title" HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblCartSummary" styleClass="lbl-muted"
               style="-fx-font-size: 12px; -fx-text-fill: #4a90d9;"/>
    </HBox>

    <!-- Search / sort toolbar -->
    <HBox styleClass="toolbar">
        <TextField fx:id="tfSearch" promptText="Search by name or category…"
                   styleClass="text-field" prefWidth="280" prefHeight="34"/>
        <Button text="Search"        onAction="#onSearch" styleClass="btn-primary"   prefHeight="34"/>
        <Button text="Sort by Price" onAction="#onSort"   styleClass="btn-secondary" prefHeight="34"/>
        <Button text="Reset"         onAction="#onReset"  styleClass="btn-secondary" prefHeight="34"/>
    </HBox>

    <!-- Product table -->
    <TableView fx:id="tableProducts" styleClass="table-view" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"       text="ID"       prefWidth="60"/>
            <TableColumn fx:id="colName"     text="Name"     prefWidth="200"/>
            <TableColumn fx:id="colPrice"    text="Price"    prefWidth="120"/>
            <TableColumn fx:id="colStock"    text="Stock"    prefWidth="80"/>
            <TableColumn fx:id="colCategory" text="Category" prefWidth="140"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Add to cart row -->
    <HBox styleClass="toolbar">
        <Label text="Qty:" styleClass="lbl-form" style="-fx-min-width: 30;"/>
        <TextField fx:id="tfQty" promptText="1" styleClass="text-field"
                   prefWidth="70" prefHeight="34"/>
        <Button text="Add to Cart"  onAction="#onAddToCart"  styleClass="btn-success"   prefHeight="34"/>
        <Button text="View Cart"    onAction="#onViewCart"   styleClass="btn-primary"   prefHeight="34"/>
        <Label fx:id="lblMsg" text="" styleClass="lbl-success" style="-fx-padding: 0 0 0 10;"/>
    </HBox>

    <!-- Back -->
    <Button text="← Back to Dashboard" onAction="#onBack" styleClass="btn-ghost"/>

</VBox>
