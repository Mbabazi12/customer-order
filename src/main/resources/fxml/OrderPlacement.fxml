<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controller.OrderController"
           styleClass="page">

    <VBox alignment="CENTER" spacing="0" maxWidth="460">

        <Label text="Place New Order" styleClass="page-title"/>
        <Label text="Fill in the details below to place your order."
               styleClass="subtitle" style="-fx-padding: 4 0 24 0;"/>

        <!-- Form -->
        <GridPane styleClass="form-grid" maxWidth="400">
            <columnConstraints>
                <ColumnConstraints minWidth="100" prefWidth="110"/>
                <ColumnConstraints hgrow="ALWAYS" prefWidth="260"/>
            </columnConstraints>

            <Label text="Product ID" styleClass="lbl-form"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="tfProductId" promptText="e.g. 101"
                       styleClass="text-field"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Quantity" styleClass="lbl-form"
                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="tfQuantity" promptText="e.g. 2"
                       styleClass="text-field"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Payment" styleClass="lbl-form"
                   GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <ComboBox fx:id="cbPayment" styleClass="combo-box" maxWidth="1.7976931348623157E308"
                      GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>

        <!-- Feedback labels -->
        <Label fx:id="lblSummary" text="" wrapText="true" maxWidth="400"
               styleClass="lbl-success" style="-fx-padding: 12 0 0 0;"/>
        <Label fx:id="lblError"   text="" wrapText="true" maxWidth="400"
               styleClass="lbl-error"   style="-fx-padding: 4 0 0 0;"/>

        <!-- Buttons -->
        <HBox spacing="14" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
            <Button text="Pay Now" onAction="#onPayNow" styleClass="btn-success"
                    prefWidth="140" prefHeight="40"/>
            <Button text="Cancel"  onAction="#onCancel" styleClass="btn-danger"
                    prefWidth="110" prefHeight="40"/>
        </HBox>

    </VBox>
</StackPane>
